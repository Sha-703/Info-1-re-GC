# Exemple de configuration d'environnement Django
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
# Pour production, utilisez un URL de base de données externe. Exemple Postgres :
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Si vous souhaitez restreindre les origines CORS en production :
# DJANGO_CORS_ALLOW_ALL_ORIGINS=False
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
